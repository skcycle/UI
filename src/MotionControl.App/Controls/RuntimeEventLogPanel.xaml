<UserControl x:Class="MotionControl.App.Controls.RuntimeEventLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:MotionControl.App.Controls"
             xmlns:vm="clr-namespace:MotionControl.Presentation.ViewModels;assembly=MotionControl.Presentation"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:RuntimeEventLogQueryViewModel}">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <controls:PageHeader Grid.Row="0"
                             Title="Event Log"
                             Hint="SQLite event history — filter by time, module, axis, level and object." />

        <!-- Toolbar: filters + buttons -->
        <Border Grid.Row="1" Style="{StaticResource SectionCardStyle}" Margin="0,8,0,8" Padding="12">
            <WrapPanel>
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <DatePicker SelectedDate="{Binding FromTime}" Width="140" Margin="0,0,12,0" />

                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <DatePicker SelectedDate="{Binding ToTime}" Width="140" Margin="0,0,12,0" />

                <TextBlock Text="Module:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding ModuleOptions}" SelectedItem="{Binding SelectedModule}"
                          Width="120" Margin="0,0,12,0" />

                <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedLevel}"
                          Width="80" Margin="0,0,12,0" />

                <TextBlock Text="Axis:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <ComboBox ItemsSource="{Binding AxisOptions}" SelectedItem="{Binding SelectedAxisNo}"
                          Width="60" Margin="0,0,12,0" />

                <TextBlock Text="Object:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox Text="{Binding SelectedObjectName, UpdateSourceTrigger=PropertyChanged}"
                         Width="100" Margin="0,0,12,0" />

                <Button Content="Search" Command="{Binding SearchCommand}" Width="70" Margin="0,0,8,0"
                        Style="{StaticResource SuccessButtonStyle}" />
                <Button Content="Recent" Command="{Binding LoadRecentCommand}" Width="60" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Clear" Command="{Binding ClearCommand}" Width="50"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </WrapPanel>
        </Border>

        <!-- Status bar (also shows loading) -->
        <Border Grid.Row="2" Padding="8,4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding QueueStatus}"
                           Foreground="{StaticResource AccentBrush}" FontSize="11"
                           Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Events}"
                  Style="{StaticResource SectionDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  AlternationCount="2">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimestampLocal}" Width="160" />
                <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="100" />
                <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="130" />
                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground"
                                    Value="{StaticResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Foreground" Value="Orange" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Axis" Binding="{Binding AxisNo}" Width="50" />
                <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" Width="120" />
                <DataGridTextColumn Header="I/O" Binding="{Binding IO}" Width="50" />
                <DataGridTextColumn Header="Addr" Binding="{Binding Address}" Width="60" />
                <DataGridTextColumn Header="Command" Binding="{Binding CommandName}" Width="130" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" MinWidth="150" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="4" Padding="4">
            <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}">
                <Run Text="{Binding Events.Count, Mode=OneWay}" /> <Run Text="rows" />
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
